{
  "name": "@firework-a/text2image",
  "version": "0.0.5",
  "description": "将图像/视频/文本渲染为文字马赛克效果，基于 Canvas",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firework-a/text2image.git"
  },
  "type": "module",
  "main": "./dist/text2image.umd.cjs",
  "module": "./dist/text2image.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/text2image.js",
      "require": "./dist/text2image.umd.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.3.0"
  }
}